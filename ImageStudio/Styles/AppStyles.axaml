<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 文字 -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.value">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- 工具栏按钮 -->
  <Style Selector="Button.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBg}" />
  </Style>
  <Style Selector="Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ChipBg}" />
  </Style>
  <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TextBlock.Foreground" Value="#55555F" />
  </Style>

  <!-- 左侧工具条 -->
  <Style Selector="Button.rail, ToggleButton.rail">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBg}" />
  </Style>
  <Style Selector="ToggleButton.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBg}" />
  </Style>
  <Style Selector="ToggleButton.rail:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ToggleButton.rail:checked PathIcon">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- 面板内小按钮 -->
  <Style Selector="Button.chip">
    <Setter Property="Background" Value="{DynamicResource ChipBg}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Height" Value="30" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ChipHoverBg}" />
  </Style>
  <Style Selector="Button.chip:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#232329" />
    <Setter Property="TextBlock.Foreground" Value="#55555F" />
  </Style>

  <!-- 主按钮 -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Height" Value="30" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
  </Style>
  <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#333A4D" />
    <Setter Property="TextBlock.Foreground" Value="#8C93A8" />
  </Style>

  <!-- 菜单 -->
  <Style Selector="Menu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Menu > MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource HoverBg}" />
  </Style>
  <Style Selector="MenuItem:disabled">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>

  <!-- 滑块 -->
  <Style Selector="Slider">
    <Setter Property="MinHeight" Value="18" />
    <Style.Resources>
      <SolidColorBrush x:Key="SliderTrackFill" Color="#3A3A46" />
      <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#454553" />
      <SolidColorBrush x:Key="SliderTrackValueFill" Color="#5B8DFF" />
      <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#749EFF" />
    </Style.Resources>
  </Style>

  <!-- 开关类小图标按钮 -->
  <Style Selector="ToggleButton.subtle:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#3A3A48" />
  </Style>
  <Style Selector="ToggleButton.subtle:checked PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- 分段按钮（选区模式） -->
  <Style Selector="ToggleButton.seg">
    <Setter Property="Background" Value="{DynamicResource ChipBg}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Height" Value="26" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.seg /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ToggleButton.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ChipHoverBg}" />
  </Style>
  <Style Selector="ToggleButton.seg:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- 输入框 -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="#1C1C22" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>

  <!-- 复选框 -->
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- 图层面板：行 -->
  <Style Selector="Border.layerRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.layerRow:pointerover">
    <Setter Property="Background" Value="#26262E" />
  </Style>
  <Style Selector="Border.layerRow.selected">
    <Setter Property="Background" Value="#2C3B55" />
  </Style>

  <!-- 图层面板：眼睛开关 -->
  <Style Selector="ToggleButton.eye">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.eye /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ToggleButton.eye:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#383844" />
  </Style>
  <Style Selector="ToggleButton.eye:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.eye:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#383844" />
  </Style>
  <Style Selector="ToggleButton.eye PathIcon">
    <Setter Property="Foreground" Value="#4E4E5A" />
  </Style>
  <Style Selector="ToggleButton.eye:checked PathIcon">
    <Setter Property="Foreground" Value="#D8DDE8" />
  </Style>

  <!-- 图层面板：底部小按钮 -->
  <Style Selector="Button.mini">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource ChipBg}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.mini:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ChipHoverBg}" />
  </Style>
  <Style Selector="Button.mini:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1F1F25" />
    <Setter Property="TextBlock.Foreground" Value="#44444E" />
  </Style>
</Styles>
