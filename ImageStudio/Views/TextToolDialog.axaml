<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ImageStudio.Views.TextToolDialog"
        Width="430"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark"
        Background="{StaticResource PanelBg}"
        FontFamily="{StaticResource AppFontFamily}"
        Icon="/Assets/app.png"
        Title="添加文字">

  <StackPanel Margin="22,18,22,20" Spacing="14">
    <TextBlock x:Name="HeaderText" Text="添加文字" FontSize="15" Foreground="{StaticResource TextPrimary}" />

    <StackPanel Spacing="6">
      <TextBlock Text="内容（支持多行）" Classes="value" />
      <TextBox x:Name="ContentBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96"
               MaxHeight="180" VerticalContentAlignment="Top" />
    </StackPanel>

    <Grid ColumnDefinitions="*,12,96,10,86">
      <StackPanel Grid.Column="0" Spacing="6">
        <TextBlock Text="字体" Classes="value" />
        <!-- 字体列表在运行时从系统字体枚举填充（Windows / macOS / Linux 各自不同） -->
        <ComboBox x:Name="FontBox" HorizontalAlignment="Stretch" />
      </StackPanel>

      <StackPanel Grid.Column="2" Spacing="6">
        <TextBlock Text="字号" Classes="value" />
        <NumericUpDown x:Name="SizeBox" Minimum="8" Maximum="512" Increment="2" FormatString="0" />
      </StackPanel>

      <CheckBox Grid.Column="4" x:Name="BoldBox" Content="粗体" FontSize="12" MinHeight="24"
                VerticalAlignment="Bottom" />
    </Grid>

    <Border Background="#232A38" CornerRadius="8" Padding="12,9">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border x:Name="ColorSwatch" Width="18" Height="18" CornerRadius="4"
                BorderBrush="#55FFFFFF" BorderThickness="1" VerticalAlignment="Center" />
        <TextBlock x:Name="ColorText" Classes="hint" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Classes="chip" Content="取消" Width="88" Click="OnCancelClick" />
      <Button Classes="accent" Content="添加图层" Width="112" Click="OnOkClick" />
    </StackPanel>
  </StackPanel>
</Window>
