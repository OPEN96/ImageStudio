<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ImageStudio.Views.TextDialog"
        Width="392"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark"
        Background="{StaticResource PanelBg}"
        FontFamily="{StaticResource AppFontFamily}"
        Icon="/Assets/app.png"
        Title="重命名">

  <StackPanel Margin="22,18,22,20" Spacing="14">
    <TextBlock x:Name="HeaderText" Text="重命名" FontSize="15" Foreground="{StaticResource TextPrimary}" />

    <StackPanel Spacing="6">
      <TextBlock Text="名称" Classes="value" />
      <TextBox x:Name="InputBox" MaxLength="64" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Classes="chip" Content="取消" Width="88" Click="OnCancelClick" />
      <Button Classes="accent" x:Name="OkButton" Content="确定" Width="104" Click="OnOkClick" />
    </StackPanel>
  </StackPanel>
</Window>
